# Copia este fichero a .env y ajusta los valores. .env nunca se versiona
# (está en .gitignore); este .env.example sí, como plantilla documentada.

# PostgreSQL
POSTGRES_USER=asistente
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=asistente
DATABASE_URL=postgresql+psycopg://asistente:cambia-esta-contrasena@localhost:5432/asistente

# Ollama (corre en el host con acceso a la GPU)
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen3:8b

# Seguridad
SECRET_KEY=genera-una-clave-aleatoria-larga

# Proveedor de LLM.
# "ollama" (por defecto): modelos locales, toda la inferencia permanece en
#   el equipo (RNF-7).
# "openai": usa OpenAI (ChatOpenAI) en vez de Ollama, sin cambios en la
#   lógica de los nodos del grafo. ADVERTENCIA: si activas "openai", los
#   mensajes del alumno y los fragmentos recuperados por RAG salen del
#   equipo hacia OpenAI y RNF-7 (privacidad, ningún dato sale del equipo)
#   deja de cumplirse. Es una capacidad opcional y consciente, no el modo
#   por defecto.
LLM_PROVIDER=ollama
# Requerido solo si LLM_PROVIDER=openai. No lo pongas en claro en un
# fichero versionado; este .env.example es una plantilla, no un secreto real.
OPENAI_API_KEY=
# Modelo usado cuando LLM_PROVIDER=openai (por defecto, un modelo "mini" de bajo coste).
OPENAI_MODEL=gpt-4o-mini

RAG_TOP_K_CHAT=8
RAG_RELEVANCE_THRESHOLD=0.42

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
# URL pública del frontend, usada para construir el enlace del correo de
# establecimiento de contraseña.
FRONTEND_URL=http://localhost:3000

# Langfuse (opcional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# Email (SMTP). En desarrollo apunta al
# contenedor Mailpit de docker-compose.yml (UI de inspección en
# localhost:8025); en producción, sustituye por un proveedor SMTP real
# sin cambiar código.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@asistente-estudio.local
# Caducidad del token de establecimiento de contraseña, en horas.
PASSWORD_SET_TOKEN_TTL_HOURS=48

# Producción — solo la lee docker-compose.prod.yml; nº de workers de
# Gunicorn (UvicornWorker) para el backend. No reduce la latencia del chat
# (el cuello de botella es la GPU de Ollama, no el backend); beneficia a los
# endpoints que no invocan al LLM.
GUNICORN_WORKERS=3
